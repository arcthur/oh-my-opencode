{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "noCheck": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "script/**/*.test.ts",
    "script/**/*.spec.ts",
    "bin/**/*.test.ts",
    "bin/**/*.spec.ts",
    "test/**/*.test.ts",
    "test/**/*.spec.ts",
    "test-setup.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
